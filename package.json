{
  "name": "stdnum",
  "version": "1.12.6",
  "description": "Standard Number Validation",
  "files": [
    "README.md",
    "LICENSE.txt",
    "lib",
    "src"
  ],
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "exports_NOT_YET": {
    "./": {
      "import": "./lib/esm/",
      "require": "./lib/cjs/"
    }
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src && tsc --noEmit -p tsconfig-lint.json",
    "test": "vitest run",
    "build": "tsc",
    "prepublishOnly:esm": "tsc -p tsconfig.json",
    "prepublishOnly:cjs": "tsc -p tsconfig-cjs.json",
    "prepublishOnly": "npm run prepublishOnly:esm && npm run prepublishOnly:cjs",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "provenance": true
  },
  "author": "David Koblas",
  "keywords": [
    "identity",
    "company",
    "person",
    "vat",
    "validation",
    "validator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koblas/stdnum-js.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
