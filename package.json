{
  "name": "stdnum",
  "version": "1.12.6",
  "description": "Standard Number Validation",
  "files": [
    "README.md",
    "LICENSE.md",
    "lib",
    "src",
    "!**/*.spec.*"
  ],
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "node": "./lib/cjs/index.js",
      "import": "./lib/esm/index.js",
      "default": "./lib/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./lib/esm/*.js": "./lib/esm/*.js",
    "./lib/esm/*": "./lib/esm/*.js",
    "./lib/cjs/*.js": "./lib/cjs/*.js",
    "./lib/cjs/*": "./lib/cjs/*.js",
    "./src/*": "./src/*",
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "node": "./lib/cjs/*.js",
      "import": "./lib/esm/*.js",
      "default": "./lib/cjs/*.js"
    }
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src && tsc --noEmit -p tsconfig-lint.json",
    "test": "vitest run",
    "build": "tsc",
    "prepublishOnly:esm": "tsc -p tsconfig.json",
    "prepublishOnly:cjs": "tsc -p tsconfig-cjs.json",
    "prepublishOnly": "npm run prepublishOnly:esm && npm run prepublishOnly:cjs",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint:package": "publint --level error && attw --pack ."
  },
  "publishConfig": {
    "provenance": true
  },
  "author": "David Koblas",
  "keywords": [
    "identity",
    "company",
    "person",
    "vat",
    "validation",
    "validator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koblas/stdnum-js.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
